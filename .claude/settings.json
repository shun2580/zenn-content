      "Bash(pkill *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(tmux kill-server*)",
      "Bash(tmux kill-session*)",
      "Bash(mkfs*)",
